# Makefile - QNN (Qualcomm AI Runtime) encryption hook demo
#
# Unlike the other frameworks in this repo, QNN requires a multi-stage
# conversion pipeline (ONNX -> patched ONNX -> QNN IR -> model lib ->
# context binary) BEFORE the usual compile/infer/hook C++ programs even
# come into play. Run `source ../install_requirements.sh` first (from
# qnn/, not qnn/src/) to set up QNN_SDK_ROOT, the Python 3.10 venv, and
# the clang++ shim.

CXX      ?= g++
CXXFLAGS ?= -std=c++17 -Wall -O2 -fPIC
BUILD_DIR  = ../build
MODELS_DIR = ../models

PASSWORD ?= changeme
MODEL    ?= $(MODELS_DIR)/model.onnx

# QNN SDK path - must be set in environment or here
QNN_SDK_ROOT ?= $(HOME)/Documents/Skyld/qnn-sdk/qairt/2.29.0.241129

# GPU is the only x86-compatible QNN backend that supports context caching
BACKEND_SO ?= $(QNN_SDK_ROOT)/lib/x86_64-linux-clang/libQnnGpu.so

# Python path for QNN tools
PYTHON ?= python3

.PHONY: all patch-onnx convert compile-lib context-binary compile-hook infer hook \
        run-baseline run-attack clean check-env

# Check environment first
check-env:
	@if [ -z "$$QNN_SDK_ROOT" ] && [ ! -d "$(QNN_SDK_ROOT)" ]; then \
		echo "ERROR: QNN_SDK_ROOT not set or invalid"; \
		echo "Run: source ../install_requirements.sh"; \
		exit 1; \
	fi
	@if [ ! -f "$(BACKEND_SO)" ]; then \
		echo "ERROR: Backend library not found: $(BACKEND_SO)"; \
		echo "Check QNN_SDK_ROOT path"; \
		exit 1; \
	fi
	@echo "QNN_SDK_ROOT=$(QNN_SDK_ROOT)"
	@echo "BACKEND_SO=$(BACKEND_SO)"

all: check-env patch-onnx convert compile-lib context-binary compile-hook infer hook

# --- Stage 0: patch the Reshape 'allowzero' attribute ---
# qnn-onnx-converter only supports allowzero=0 (the pre-opset-14 default).
patch-onnx: $(MODELS_DIR)/model_patched.onnx

# CORRECTION: Utilisation d'un script Python séparé
$(MODELS_DIR)/model_patched.onnx: $(MODEL) patch_onnx.py
	$(PYTHON) patch_onnx.py $< $@

# --- Stage 1: ONNX -> QNN IR (.cpp + .bin) ---
convert: $(BUILD_DIR)/model.cpp

$(BUILD_DIR)/model.cpp: $(MODELS_DIR)/model_patched.onnx
	@if [ ! -d "$(QNN_SDK_ROOT)" ]; then \
		echo "ERROR: QNN_SDK_ROOT directory not found: $(QNN_SDK_ROOT)"; \
		exit 1; \
	fi
	$(QNN_SDK_ROOT)/bin/x86_64-linux-clang/qnn-onnx-converter \
		--input_network $< \
		--output_path $(BUILD_DIR)/model.cpp

# --- Stage 2: QNN IR -> model lib (.so) ---
compile-lib: $(BUILD_DIR)/model_libs/x86_64-linux-clang/libmodel.so

$(BUILD_DIR)/model_libs/x86_64-linux-clang/libmodel.so: $(BUILD_DIR)/model.cpp $(BUILD_DIR)/model.bin
	$(QNN_SDK_ROOT)/bin/x86_64-linux-clang/qnn-model-lib-generator \
		-c $(BUILD_DIR)/model.cpp \
		-b $(BUILD_DIR)/model.bin \
		-o $(BUILD_DIR)/model_libs \
		-t x86_64-linux-clang

$(BUILD_DIR)/model.bin: $(BUILD_DIR)/model.cpp
	# model.bin is generated by qnn-onnx-converter along with model.cpp
	@if [ ! -f "$@" ]; then \
		echo "Error: model.bin not found. Re-run convert stage."; \
		exit 1; \
	fi

# --- Stage 3: model lib -> context binary ---
context-binary: $(BUILD_DIR)/model_context.bin

$(BUILD_DIR)/model_context.bin: $(BUILD_DIR)/model_libs/x86_64-linux-clang/libmodel.so
	@if [ ! -f "$(BACKEND_SO)" ]; then \
		echo "ERROR: Backend library not found: $(BACKEND_SO)"; \
		exit 1; \
	fi
	$(QNN_SDK_ROOT)/bin/x86_64-linux-clang/qnn-context-binary-generator \
		--backend $(BACKEND_SO) \
		--model $(BUILD_DIR)/model_libs/x86_64-linux-clang/libmodel.so \
		--binary_file $(abspath $(BUILD_DIR))/model_context \
		--log_level info
	@if [ -f "$(abspath $(BUILD_DIR))/model_context.bin.bin" ]; then \
		mv "$(abspath $(BUILD_DIR))/model_context.bin.bin" "$@"; \
	elif [ -f "$(abspath $(BUILD_DIR))/model_context.bin" ]; then \
		mv "$(abspath $(BUILD_DIR))/model_context.bin" "$@"; \
	else \
		echo "ERROR: model_context.bin not generated"; \
		exit 1; \
	fi

# --- C++ programs ---
compile-hook: $(BUILD_DIR)/compile_qnn

$(BUILD_DIR)/compile_qnn: compile_qnn.cpp
	mkdir -p $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) $< -o $@ -lcrypto

infer: $(BUILD_DIR)/infer_qnn

$(BUILD_DIR)/infer_qnn: infer_qnn.cpp
	mkdir -p $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -I$(QNN_SDK_ROOT)/include $< -o $@ -lcrypto -ldl

hook: $(BUILD_DIR)/qnn_context_hook.so

$(BUILD_DIR)/qnn_context_hook.so: qnn_context_hook.cpp
	mkdir -p $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -shared -I$(QNN_SDK_ROOT)/include $< -o $@ -ldl

# --- Encrypt the context binary ---
$(BUILD_DIR)/model_context.bin.enc: $(BUILD_DIR)/model_context.bin $(BUILD_DIR)/compile_qnn
	$(BUILD_DIR)/compile_qnn "$(PASSWORD)" $(BUILD_DIR)/model_context.bin $(BUILD_DIR)/model_context.bin.enc

# --- Run without the hook: confirms the pipeline works end-to-end ---
run-baseline: check-env $(BUILD_DIR)/model_context.bin.enc $(BUILD_DIR)/infer_qnn
	@echo "=== Running baseline (no hook) ==="
	cd $(BUILD_DIR) && \
	LD_LIBRARY_PATH=$(QNN_SDK_ROOT)/lib/x86_64-linux-clang:$$LD_LIBRARY_PATH \
	./infer_qnn model_context.bin.enc "$(PASSWORD)" $(BACKEND_SO)

# --- Run with LD_PRELOAD hook: demonstrates the runtime buffer theft ---
run-attack: check-env $(BUILD_DIR)/model_context.bin.enc $(BUILD_DIR)/infer_qnn $(BUILD_DIR)/qnn_context_hook.so
	@echo "=== Running with hook (attack) ==="
	mkdir -p $(MODELS_DIR)
	cd $(BUILD_DIR) && \
	LD_LIBRARY_PATH=$(QNN_SDK_ROOT)/lib/x86_64-linux-clang:$$LD_LIBRARY_PATH \
	LD_PRELOAD=./qnn_context_hook.so \
	./infer_qnn model_context.bin.enc "$(PASSWORD)" $(BACKEND_SO)
	@echo ""
	@if [ -f "$(MODELS_DIR)/dumped_model_context.bin" ]; then \
		echo "=== Comparing dumped buffer ==="; \
		diff $(MODELS_DIR)/dumped_model_context.bin $(BUILD_DIR)/model_context.bin \
			&& echo "IDENTICAL — model theft confirmed!"; \
	else \
		echo "Dumped file not found!"; \
	fi

clean:
	rm -f $(MODELS_DIR)/model_patched.onnx
	rm -f $(BUILD_DIR)/model.cpp $(BUILD_DIR)/model.bin
	rm -rf $(BUILD_DIR)/model_libs
	rm -f $(BUILD_DIR)/model_context.bin $(BUILD_DIR)/model_context.bin.enc
	rm -f $(MODELS_DIR)/dumped_model_context.bin
	rm -f $(BUILD_DIR)/compile_qnn $(BUILD_DIR)/infer_qnn $(BUILD_DIR)/qnn_context_hook.so