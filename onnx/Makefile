# Delegating Makefile for ONNX framework
.PHONY: all clean run-baseline run-attack run-attack-c run-attack-cxx run-attack-double hook-cxx-experimental setup

all:
	$(MAKE) -C src $@

clean:
	$(MAKE) -C src $@

run-baseline:
	$(MAKE) -C src $@

run-attack:
	$(MAKE) -C src $@

run-attack-c:
	$(MAKE) -C src $@

run-attack-cxx:
	$(MAKE) -C src $@

run-attack-double:
	$(MAKE) -C src $@

hook-cxx-experimental:
	$(MAKE) -C src $@

setup:
	$(MAKE) -C src $@
