# Compiled binaries
*.o
*.so
*.exe
*.dll
*.dylib

# Build directories (generated by make/cmake, never needs to exist empty in git)
**/build/

# Generated models (encrypted and dumped)
**/models/*.enc
**/models/dumped_*
**/models/*.bin
**/models/*.xml
**/models/*.tflite
**/models/*.onnx
**/models/converted_model/

# Leftover compiled binaries if they ever end up directly in src/
# (named explicitly, not with a wildcard, so the matching .cpp/.c source files are never shadowed)
**/src/compile_ov
**/src/compile_onnx
**/src/compile_tflite
**/src/compile
**/src/infer_ov
**/src/infer_onnx
**/src/infer_tflite
**/src/infer

# Old directories (to be removed)
**/examples/
**/runtime/
**/attack/
**/tests/

# TensorRT specific
tensorrt/runtime/
tensorrt/attack/
tensorrt/engines/

# VS Code
.vscode/
*.code-workspace

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
env/
.venv/
.env/

# Logs and temp
*.log
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

