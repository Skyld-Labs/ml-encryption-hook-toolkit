# Compiled binaries
*.o
*.so
*.exe
*.dll
*.dylib

# Build directories (generated by make/cmake) — keep the folder structure via .gitkeep
**/build/*
!**/build/.gitkeep

# Generated models (encrypted and dumped)
**/models/*.enc
**/models/dumped_*
**/models/*.bin
**/models/*.xml
**/models/*.tflite
**/models/*.engine
**/models/*.onnx
**/models/converted_model/

# Leftover compiled binaries if they ever end up directly in src/
# (named explicitly, not with a wildcard, so the matching .cpp/.c source files are never shadowed)
**/src/compile_ov
**/src/compile_onnx
**/src/compile_tflite
**/src/compile
**/src/compile_qnn
**/src/compile_pt
**/src/infer_ov
**/src/infer_onnx
**/src/infer_tflite
**/src/infer
**/src/infer_qnn
**/src/infer_pt
**/src/output/
**/src/__pycache__/

# Old directories (to be removed)
**/examples/
**/runtime/
**/attack/
**/tests/

# TensorRT specific
tensorrt/runtime/
tensorrt/attack/
tensorrt/engines/

# QNN specific — intermediate pipeline artifacts already covered by **/build/*,
# but the patched ONNX derivative is easy to forget since it lives in models/
qnn/models/model_patched.onnx

# VS Code
.vscode/
*.code-workspace

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
env/
.venv/
.env/

# Logs and temp
*.log
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.idea/
*.iml